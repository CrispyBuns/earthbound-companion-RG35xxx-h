diff --git a/ebtools/rom.py b/ebtools/rom.py
--- a/ebtools/rom.py
+++ b/ebtools/rom.py
@@ -1,31 +1,45 @@
 """ROM detection: header check, checksum validation, title matching."""
 
+import hashlib
 import struct
 from dataclasses import dataclass
 
 # Size of an EarthBound/Mother 2 ROM, header stripped.
 ROM_SIZE = 0x300000
 
+# Vanilla EarthBound ROM with the user's custom SPC music applied.
+# This is an additional allow-list entry; standard header validation remains
+# unchanged for every other ROM.
+CUSTOM_ROM_MD5 = "16a8d3d7eea1312324fe8212a48453d3"
+
 
 @dataclass
 class DetectResult:
     header: bool
     matched: bool
 
 
 def detect(data: bytes, identifier: str) -> DetectResult:
     """Check SNES header at two possible offsets (headerless and headered).
 
     Returns whether the ROM matched and whether it has a 512-byte SMC header.
     """
     # Try headerless (base=0xFFB0) then headered (base=0x101B0)
     for headered, base in [(False, 0xFFB0), (True, 0x101B0)]:
         if base + 48 > len(data):
             continue
         checksum_complement = struct.unpack_from("<H", data, base + 44)[0]
         checksum = struct.unpack_from("<H", data, base + 46)[0]
         if (checksum ^ checksum_complement) == 0xFFFF:
             title = data[base + 16 : base + 37].decode("ascii", errors="replace")
             if title == identifier:
                 return DetectResult(header=headered, matched=True)
+
+    # The custom soundtrack ROM may have a stale SNES header checksum. Accept
+    # only the exact known file hash, and preserve header stripping for .smc
+    # files with a 512-byte copier header.
+    if (
+        len(data) in (ROM_SIZE, ROM_SIZE + 512)
+        and hashlib.md5(data).hexdigest() == CUSTOM_ROM_MD5
+    ):
+        return DetectResult(header=(len(data) == ROM_SIZE + 512), matched=True)
+
     return DetectResult(header=False, matched=False)
