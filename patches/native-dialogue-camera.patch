+        case GAME_MODE_SETTINGS_MENU: case GAME_MODE_KEY_ITEMS_MENU:
+        case GAME_MODE_BICYCLE_DISMOUNT: case GAME_MODE_HP_ALERT:
+            break;
+        default:
+            return false;
+        }
+    }
+    return true;
+}
