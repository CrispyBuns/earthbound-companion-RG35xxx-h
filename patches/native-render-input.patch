+static _Atomic bool chime_requested;
+static unsigned chime_sample = AUDIO_SAMPLE_RATE / 3;
+
+/* Independent, generated two-note chime: no borrowed sound asset or game SFX
+ * channel is needed. The audio callback owns the sample cursor. */
+void platform_audio_achievement_chime(void) {
+    if (audio_device) atomic_store(&chime_requested, true);
+}
+static void mix_achievement_chime(int16_t *out, int frames) {
+    if (atomic_exchange(&chime_requested, false)) chime_sample = 0;
+    const unsigned length = AUDIO_SAMPLE_RATE / 3, note = length / 2;
+    for (int frame = 0; frame < frames && chime_sample < length; frame++, chime_sample++) {
+        unsigned at = chime_sample % note;
+        double envelope = (double)(note - at) / note;
+        if (at < 160) envelope *= at / 160.0;
+        double frequency = chime_sample < note ? 659.255 : 880.0;
+        int sound = (int)(2400 * envelope * sin(6.283185307179586 * frequency * at / AUDIO_SAMPLE_RATE));
+        for (int channel = 0; channel < 2; channel++) {
+            int mixed = out[frame * 2 + channel] + sound;
+            out[frame * 2 + channel] = (int16_t)(mixed > 32767 ? 32767 : mixed < -32768 ? -32768 : mixed);
+        }
+    }
+}
+bool platform_audio_achievement_chime_selftest(void) {
+    int16_t samples[1024];bool audible[2] = {false,false};
+    atomic_store(&chime_requested, true);
+    for(unsigned chunk=0;chunk<22;chunk++) {
+        memset(samples,0,sizeof(samples));mix_achievement_chime(samples,512);
+        for(unsigned at=0;at<512;at++) {
+            if(samples[at*2]!=samples[at*2+1] || samples[at*2]>2400 || samples[at*2]<-2400)return false;
+            if(chunk<10)audible[0] |= samples[at*2]!=0;
+            if(chunk>=11)audible[1] |= samples[at*2]!=0;
+        }
+    }
+    if(chime_sample!=AUDIO_SAMPLE_RATE/3)return false;
+    memset(samples,0,sizeof(samples));
+    mix_achievement_chime(samples,512);
+    for(unsigned at=0;at<1024;at++)if(samples[at])return false;
+    fprintf(stderr,"Achievement chime: both notes, stereo, bounded amplitude and completion %s\n",audible[0]&&audible[1]?"PASS":"FAIL");
+    return audible[0]&&audible[1];
+}
 
