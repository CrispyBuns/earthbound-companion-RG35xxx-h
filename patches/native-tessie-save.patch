+void repair_jeff_join_story_flag(void) {
+    bool ness = false, jeff = false, other_pc = false;
+    for (unsigned i = 0; i < TOTAL_PARTY_COUNT; i++) {
+        uint8_t member = game_state.party_members[i];
+        if (member == 1) ness = true;
+        if (member == 3) jeff = true;
+        if (member >= 1 && member <= 4 && member != 3) other_pc = true;
+    }
+    /* Redux explicitly marks this chapter with FLG_JEFF_SOLO (798).
+     * The old load repair mistook Jeff becoming playable for his later
+     * Threed reunion. FLG_JEFF (14) then made the tent cook skip both
+     * Tessie hotspots. Repair only the unequivocal solo Redux state. */
+    if (maternalbound_enabled() && event_flag_get(798) &&
+        event_flag_get(128) && game_state.party_members[0] == 3 &&
+        jeff && !other_pc) {
+        event_flag_clear(14);
+    } else if (ness && jeff && !event_flag_get(14)) {
+        /* Actual coexistence proves the reunion; ever-playable does not. */
+        event_flag_set(14);
+    }
+}
 
