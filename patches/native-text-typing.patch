+void dt_queue_string(ModeState *out, const uint8_t *str, int max_len, bool wrap) {
+    DisplayTextModeState *st = &out->display_text;
+    unsigned start = st->substitution_length;
+    for (int i = 0; i < max_len && str[i]; ++i) {
